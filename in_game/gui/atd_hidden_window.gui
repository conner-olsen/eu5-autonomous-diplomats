basic_dialog = {
	name = "atd_hidden_window"
	widgetid = atd_hidden_window
	layer = top
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	parentanchor = center
	position = { -10000 1 }
	blockoverride "header_text" {
		raw_text = "ATD: Hidden Window"
	}
	blockoverride "content" {
		vbox = {
			# Gated by atd_should_run: visible only between atd_on_monthly setting
			# atd_pending_action and atd_gui_sync_step clearing it.
			visible = "[And(GetPlayer.Exists, GetScriptedGui('atd_should_run').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			datacontext = "[GetQuickTemporaryCountryRelations(Player.Self)]"

			# Iter trigger before sync_step so atd_improving_seen is populated
			# before reconcile reads it. Self-re-trigger keeps the state firing
			# every 0.5s while the gate is up - trigger_on_create is one-shot
			# per widget creation, and the widget isn't recreated when the gate
			# flips false then true again.
			overlappingitembox = {
				state = {
					name = atd_hidden_window_driver
					trigger_on_create = yes
					duration = 0.5
					on_finish = "[PdxGuiTriggerAllAnimations('atd_gui_sync_iter')]"
					on_finish = "[GetScriptedGui('atd_gui_sync_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					on_finish = "[PdxGuiTriggerAllAnimations('atd_do_auto_cancel')]"
					on_finish = "[PdxGuiTriggerAllAnimations('atd_do_auto_confirm')]"
					next = atd_hidden_window_driver2
				}
				state = {
					name = atd_hidden_window_driver2
					on_finish = "[PdxGuiTriggerAllAnimations('atd_gui_sync_iter')]"
					on_finish = "[GetScriptedGui('atd_gui_sync_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					on_finish = "[PdxGuiTriggerAllAnimations('atd_do_auto_cancel')]"
					on_finish = "[PdxGuiTriggerAllAnimations('atd_do_auto_confirm')]"
				}
			}

			# Iter widgets: one per country in atd_sync_check_list, fire tracking
			# only if currently IsImprovingOpinion.
			vbox = {
				datamodel = "[GetPlayer.MakeScope.GetList('atd_sync_check_list')]"
				item = {
					# Scope.GetCountry unwraps the variable_list's generic Scope
					# wrapper into a Country. Same pattern lsq_hidden_window uses.
					widget = {
						datacontext = "[Scope.GetCountry]"
						# HasTemporaryRelation guard avoids 'FetchData failed' spam
						# from the inner widget dereferencing a null
						# OngoingRelationCountry on countries with no ongoing relations.
						widget = {
							visible = "[QuickTemporaryCountryRelations.HasTemporaryRelation(Country.Self)]"
							widget = {
								datacontext = "[QuickTemporaryCountryRelations.GetTemporaryRelation(Country.Self)]"
								visible = "[OngoingRelationCountry.IsImprovingOpinion]"
								state = {
									name = atd_gui_sync_iter
									on_finish = "[GetScriptedGui('atd_gui_sync_track').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('country', Country.MakeScope).End)]"
								}
							}
						}
					}
				}
			}
		}
	}
}
