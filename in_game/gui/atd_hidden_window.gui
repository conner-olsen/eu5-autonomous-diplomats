basic_dialog = {
	name = "atd_hidden_window"
	widgetid = atd_hidden_window
	layer = top
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	parentanchor = center
	position = { -10000 1 }
	blockoverride "header_text" {
		raw_text = "ATD: Hidden Window"
	}
	blockoverride "content" {
		vbox = {
			visible = "[GetPlayer.Exists]"
			datacontext = "[GetQuickTemporaryCountryRelations(Player.Self)]"

			# Driver: every 2 seconds, advance the sync state machine, then fan out
			# to the iter widgets. Cycle 1 (no flag) populates atd_sync_check_list
			# from every_country_in_diplomatic_range, clears atd_improving_seen,
			# and sets atd_gui_sync_collecting so the iter widgets become visible.
			# Cycle 2 (flag set) reconciles atd_improving_with against
			# atd_improving_seen: drops canceled/completed entries and adds newly
			# discovered player-initiated improvements. Then clears the flag.
			overlappingitembox = {
				state = {
					name = atd_hidden_window_driver
					trigger_on_create = yes
					duration = 0.5
					on_finish = "[GetScriptedGui('atd_gui_sync_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					on_finish = "[PdxGuiTriggerAllAnimations('atd_gui_sync_iter')]"
					# Polls the auto-cancel widgets in outliner_entries.gui each
					# cycle. We trigger explicitly rather than relying on the
					# widget's _show state transitioning when atd_pending_cancel
					# flips - the latter wasn't firing reliably (likely because
					# Country.MakeScope.GetVariable doesn't push reactive
					# visibility updates), so we just poll every 0.5s instead.
					on_finish = "[PdxGuiTriggerAllAnimations('atd_do_auto_cancel')]"
					on_finish = "[PdxGuiWidget.TriggerAnimation('atd_hidden_window_driver')]"
				}
			}

			# Iter section: walks atd_sync_check_list, which the script populates
			# in begin phase from every_country_in_diplomatic_range plus any
			# already-tracked countries. For each country currently being improved
			# (per the diplomatic engine), fires the tracking call to refresh
			# progress and mark as seen. The end phase reconciles atd_improving_with
			# against atd_improving_seen, so this picks up both mod-initiated and
			# player-initiated improve_relations actions.
			# Visibility is gated by the collecting flag so animations only fire
			# during cycle 1.
			vbox = {
				visible = "[GetScriptedGui('atd_gui_sync_is_collecting').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				datamodel = "[GetPlayer.MakeScope.GetList('atd_sync_check_list')]"
				item = {
					# Items in a variable_list iterated from GUI come through as a
					# generic Scope wrapper, not the underlying typed object.
					# Scope.GetCountry pulls the Country out so Country.Self below
					# resolves correctly. Same pattern lsq_hidden_window uses with
					# Scope.GetLocation / Scope.GetBuildingType.
					widget = {
						datacontext = "[Scope.GetCountry]"
						# Outer guard: HasTemporaryRelation is safe to call on any
						# country (no OngoingRelationCountry context required).
						# Countries with no ongoing relations to the player are
						# filtered out here so the inner widget never references
						# OngoingRelationCountry on a null context (which would spam
						# 'FetchData failed' warnings to the log).
						widget = {
							visible = "[QuickTemporaryCountryRelations.HasTemporaryRelation(Country.Self)]"
							widget = {
								datacontext = "[QuickTemporaryCountryRelations.GetTemporaryRelation(Country.Self)]"
								visible = "[OngoingRelationCountry.IsImprovingOpinion]"
								state = {
									name = atd_gui_sync_iter
									on_finish = "[GetScriptedGui('atd_gui_sync_track').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('country', Country.MakeScope).End)]"
								}
							}
						}
					}
				}
			}
		}
	}
}
