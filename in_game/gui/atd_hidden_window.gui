basic_dialog = {
	name = "atd_hidden_window"
	widgetid = atd_hidden_window
	layer = top
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	parentanchor = center
	position = { -10000 1 }
	blockoverride "header_text" {
		raw_text = "ATD: Hidden Window"
	}
	blockoverride "content" {
		vbox = {
			# Gated by atd_should_run. atd_on_monthly sets atd_pending_action,
			# the gate flips true, this vbox becomes visible, the driver state
			# below instantiates and fires once 0.5s later. atd_gui_sync_step
			# removes atd_pending_action at the end of that single tick, the
			# gate flips false, this vbox disappears, the driver state dies.
			# Result: one tick per monthly pulse, zero work between monthly ticks.
			visible = "[And(GetPlayer.Exists, GetScriptedGui('atd_should_run').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			datacontext = "[GetQuickTemporaryCountryRelations(Player.Self)]"

			# Driver: single-fire 0.5s state. atd_on_monthly already ran
			# atd_gui_sync_begin (populating atd_sync_check_list and clearing
			# atd_improving_seen) before the gate flipped, so by the time this
			# state fires its on_finish chain the iter widgets below have
			# already been instantiated by the datamodel. The chain order
			# matters:
			#   1. Trigger atd_gui_sync_iter - synchronously walks the iter
			#      widgets, each calls atd_gui_sync_track to add its country
			#      to atd_improving_seen (only if currently IsImprovingOpinion).
			#   2. Run atd_gui_sync_step - reconciles atd_improving_with
			#      against the just-populated atd_improving_seen, runs mod
			#      logic (atd_enforce_on_subjects + atd_improve_relations),
			#      removes atd_pending_action.
			#   3. Trigger atd_do_auto_cancel - mod logic may have set
			#      atd_pending_cancel on countries at the opinion cap; this
			#      fires the outliner widgets so they call OnRightClick.
			#   4. Trigger atd_do_auto_confirm - polled fallback for the popup
			#      widget's trigger_on_create, in case the popup spawned this
			#      frame and its trigger_on_create didn't fire.
			# After step 2, atd_should_run is false and the parent vbox is
			# becoming invisible, but on_finish actions 3-4 still run on the
			# already-triggered animations (they target widgets in
			# outliner_entries.gui and ingame_dialogs.gui, not children of
			# this hidden window).
			overlappingitembox = {
				state = {
					name = atd_hidden_window_driver
					trigger_on_create = yes
					duration = 0.5
					on_finish = "[PdxGuiTriggerAllAnimations('atd_gui_sync_iter')]"
					on_finish = "[GetScriptedGui('atd_gui_sync_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					on_finish = "[PdxGuiTriggerAllAnimations('atd_do_auto_cancel')]"
					on_finish = "[PdxGuiTriggerAllAnimations('atd_do_auto_confirm')]"
				}
			}

			# Iter section: walks atd_sync_check_list (populated by atd_on_monthly
			# from every_country_in_diplomatic_range plus already-tracked
			# countries). For each country currently being improved per the
			# diplomatic engine (filtered by OngoingRelationCountry.IsImprovingOpinion),
			# fires the tracking call. Visibility is inherited from the parent
			# vbox - no separate flag needed because the parent is only visible
			# during the single monthly tick window.
			vbox = {
				datamodel = "[GetPlayer.MakeScope.GetList('atd_sync_check_list')]"
				item = {
					# Items in a variable_list iterated from GUI come through as a
					# generic Scope wrapper, not the underlying typed object.
					# Scope.GetCountry pulls the Country out so Country.Self below
					# resolves correctly. Same pattern lsq_hidden_window uses with
					# Scope.GetLocation / Scope.GetBuildingType.
					widget = {
						datacontext = "[Scope.GetCountry]"
						# Outer guard: HasTemporaryRelation is safe to call on any
						# country (no OngoingRelationCountry context required).
						# Countries with no ongoing relations to the player are
						# filtered out here so the inner widget never references
						# OngoingRelationCountry on a null context (which would spam
						# 'FetchData failed' warnings to the log).
						widget = {
							visible = "[QuickTemporaryCountryRelations.HasTemporaryRelation(Country.Self)]"
							widget = {
								datacontext = "[QuickTemporaryCountryRelations.GetTemporaryRelation(Country.Self)]"
								visible = "[OngoingRelationCountry.IsImprovingOpinion]"
								state = {
									name = atd_gui_sync_iter
									on_finish = "[GetScriptedGui('atd_gui_sync_track').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('country', Country.MakeScope).End)]"
								}
							}
						}
					}
				}
			}
		}
	}
}
